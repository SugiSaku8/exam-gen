  "proof": {
    "P1": {
      "target": "△BCF ∽ △ADE",
      "steps": [
        {
          "id": "S1",
          "claim": "∠BCF = ∠ACB",
          "reason": "FはAC上にある"
        },
        {
          "id": "S2",
          "claim": "∠DAE = ∠DAC = ∠DBC",
          "reason": "EはAD上、また∠DACと∠DBCは同じ弧DCに対する円周角"
        },
        {
          "id": "S3",
          "claim": "∠BCF = ∠DAE",
          "reason": "∠ACB＝∠ACE（条件）かつ、円周角の関係とEがAD上にあることから対応角を整理する"
        },
        {
          "id": "S4",
          "claim": "∠BFC = ∠AED",
          "reason": "∠BFCは直線BDとACのなす角、∠AEDはADとECのなす角。S1–S3の角関係より対応するもう一組の角が等しい"
        },
        {
          "id": "S5",
          "claim": "△BCF ∽ △ADE",
          "reason": "2組の角がそれぞれ等しい"
        }
      ],
      "proof_note": "機械生成用の角追跡では、S3–S4を角の向き付き表現で検証すること。答案では、円周角と∠ACB＝∠ACEを用いて2組の角の等しさを示す。"
    },
    "P2": {
      "derivation": [
        {
          "claim": "△BCF ∽ △ADEより BF/AE = BC/AD = 3/6 = 1/2",
          "reason": "相似比"
        },
        {
          "claim": "△ACEで ∠CAE = ∠CAD = 20°、∠ACE = ∠ACB = 60°",
          "reason": "EはAD上、弧BC＝弧CDより対応する円周角を求める"
        },
        {
          "claim": "AE/AC = sin60°/sin100°",
          "reason": "正弦定理"
        },
        {
          "claim": "AC=AD=6 より AE = 6 sin60°/sin100°",
          "reason": "条件と正弦定理"
        },
        {
          "claim": "BF = 3 sin60°/sin100° ≈ 2.638 cm",
          "reason": "BF/AE=1/2"
        }
      ],
      "answer_exact": "3 sin(60°) / sin(100°) cm",
      "answer_approx_cm": 2.638
    }
