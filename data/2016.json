  "problem": {
    "type": "geometry_proof",
    "statement": {
      "raw": "図5において、4点A,B,C,Dは円Oの円周上の点であり、AD∥BCである。点Dを通りACに平行な直線とBCとの交点をEとし、BE上に∠ACD=∠BDFとなる点Fをとる。また、ACとDB、DFとの交点をそれぞれG、Hとする。このとき、次の（1）、（2）の問いに答えなさい。",
      "conditions": [
        "A,B,C,Dは円Oの円周上",
        "AD∥BC",
        "Dを通りACに平行な直線とBCとの交点がE",
        "FはBE上で∠ACD=∠BDF",
        "G=AC∩DB",
        "H=AC∩DF"
      ]
    },
    "parts": [
      {
        "id": "P1",
        "number": 1,
        "type": "proof",
        "points": 5,
        "question": "BF=ECであることを証明しなさい。",
        "target": {
          "relation": "equal_length",
          "segments": [
            "BF",
            "EC"
          ]
        }
      },
      {
        "id": "P2",
        "number": 2,
        "type": "angle",
        "points": 4,
        "question": "弧AD:弧DC=1:2、∠FHC=65°のとき、∠FDCの大きさを求めなさい。",
        "target": {
          "quantity": "angle",
          "angle": "FDC",
          "unit": "degree",
          "answer": 42
        }
      }
    ]
  },
